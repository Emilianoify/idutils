# Variables del despliegue con Docker (docker compose).
#
# Copiar manualmente a un archivo protegido FUERA de carpetas sincronizadas y
# pasarlo con `docker compose --env-file <ruta>`. Nunca guardar valores reales acá.
#
# Nada de esto tiene default cuando es un secreto. Un default es una credencial
# conocida que sobrevive justamente en las instalaciones donde nadie la cambió.

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=idutils
POSTGRES_DB=idutils
# Si lleva @ : / ? # o %, escribirla percent-encoded: viaja adentro de una URL.
POSTGRES_PASSWORD=

# --- Backend ----------------------------------------------------------------
# Puerto publicado SOLO en 127.0.0.1. Adentro del contenedor siempre es 4000.
# En producción, el proxy TLS del host reenvía tráfico a este puerto local.
BACKEND_PORT=4000

# Dos secretos DISTINTOS, mínimo 32 caracteres. El backend no arranca si son
# iguales: con el mismo secreto, un access token robado se presenta en
# /api/auth/refresh y se renueva solo para siempre.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Orígenes del frontend, separados por coma. Nunca "*": con cookies de sesión el
# navegador directamente lo rechaza.
ALLOWED_ORIGINS=

# Producción falla al arrancar si esto no es true. No se incluye dominio ni
# certificado: el operador debe configurar su propio proxy TLS.
COOKIE_SECURE=true

# Saltos de reverse proxy en los que confiar para leer la IP real.
# Producción falla al arrancar con 0. Usar la cantidad REAL de proxies confiables.
# De más: cualquiera falsifica su IP y esquiva el límite de intentos de login.
TRUST_PROXY_HOPS=1

LOG_LEVEL=info

# --- Seed de instalación ----------------------------------------------------
# Se usan una sola vez:
#   docker compose run --rm migrate pnpm db:seed
#
# Mínimo 12 caracteres. Si el usuario ya existe, el seed NO pisa la contraseña.
SEED_ADMIN_EMAIL=admin@idutils.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administración

# Datos de ejemplo (obra social, empresa con convenio, localidad, profesional).
# En una instalación real va en false.
SEED_DEMO=false
