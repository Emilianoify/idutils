# Una instalacion por coordinacion (D3): esta base no se comparte con nadie.
# En Docker, el host es el nombre del servicio, no localhost.
DATABASE_URL="postgresql://idutils:cambiar@localhost:5432/idutils?schema=public"

# Base SEPARADA para `pnpm test:integration`. Obligatoria para correrlos.
# Esos tests hacen TRUNCATE de todas las tablas: apuntarlos a la base de
# trabajo borra los datos de la coordinacion, y no avisa antes.
TEST_DATABASE_URL="postgresql://idutils:cambiar@localhost:5432/idutils_test?schema=public"

NODE_ENV=development
PORT=4000

# Dos secretos DISTINTOS, minimo 32 caracteres cada uno. El proceso no arranca
# si son iguales: con el mismo secreto, un access token robado se puede
# presentar en /api/auth/refresh y renovarse solo para siempre.
#
# Generar uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Origenes del frontend, separados por coma. Nunca "*": con cookies de sesion
# el navegador directamente lo rechaza.
ALLOWED_ORIGINS="http://localhost:3000"

# "true" SOLO si se sirve por HTTPS. En HTTP plano el navegador descarta la
# cookie y el sintoma es un login que aparenta no hacer nada.
# NODE_ENV=production exige true y falla al arrancar con false.
COOKIE_SECURE=false

# Saltos de reverse proxy en los que confiar para leer la IP real.
# 0 sin proxy adelante. 1 en Docker detras de nginx o Traefik.
# De mas: cualquiera falsifica su IP y esquiva el limite de intentos de login.
# De menos: toda la coordinacion comparte la IP del proxy y se limitan entre si.
# NODE_ENV=production exige al menos 1; debe coincidir con la topologia real.
TRUST_PROXY_HOPS=0

# Opcional. Por defecto "info".
# LOG_LEVEL=info

# --- Seed de instalacion (pnpm db:seed) ---------------------------------
# El primer usuario, el que abre la puerta. Rol ADMIN.
# La contrasena NO tiene default a proposito: un default es una credencial
# conocida que sobrevive justamente en las instalaciones donde nadie la cambio.
# Minimo 12 caracteres. Si el usuario ya existe, el seed NO la pisa.
SEED_ADMIN_EMAIL="admin@idutils.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administración"

# Datos de ejemplo para probar la API a mano (obra social, empresa con
# convenio, localidad y profesional). En una instalacion real va en false.
SEED_DEMO=false
